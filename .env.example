# JARVIS LLM routing
# AUTO = remote first, local fallback
# REMOTE = remote only
# LOCAL = local only
JARVIS_LLM_MODE=AUTO

# Dedicated free computer running Ollama on the LAN.
# Replace the IP with that computer's LAN IPv4 address.
JARVIS_LLM_REMOTE_HOST=http://192.168.1.100:11434
JARVIS_LLM_REMOTE_MODEL=qwen3:8b

# Fallback Ollama on the JARVIS laptop.
JARVIS_LLM_LOCAL_HOST=http://127.0.0.1:11434
JARVIS_LLM_LOCAL_MODEL=qwen3:8b

# Keep this short enough that AUTO can fail over quickly.
JARVIS_LLM_TIMEOUT=30
